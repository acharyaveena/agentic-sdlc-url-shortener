<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.veenaacharya.agentic</groupId>
    <artifactId>agentic-sdlc-url-shortener</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>agentic-sdlc-url-shortener</name>
    <description>Governed agentic SDLC orchestrator; demo target is a URL shortener.</description>

    <modules>
        <module>orchestrator</module>
        <module>url-shortener</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <copilot.sdk.version>1.0.28</copilot.sdk.version>
        <copilot.runtime.classifier>linux-x64</copilot.runtime.classifier>
    </properties>

    <profiles>
        <!-- The Copilot SDK needs a platform-specific runtime jar. -->
        <profile>
            <id>runtime-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <copilot.runtime.classifier>win32-x64</copilot.runtime.classifier>
            </properties>
        </profile>
        <profile>
            <id>runtime-mac-arm</id>
            <activation>
                <os><family>mac</family><arch>aarch64</arch></os>
            </activation>
            <properties>
                <copilot.runtime.classifier>darwin-arm64</copilot.runtime.classifier>
            </properties>
        </profile>
    </profiles>
</project>
